# =========================================================
# Database (Supabase Postgres)
# =========================================================
# Lấy connection string từ Supabase Dashboard:
#   Project Settings -> Database -> Connection string
#
# Khuyên dùng Session pooler (port 5432) cho FastAPI + SQLAlchemy + Alembic.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DB_ECHO=false

# =========================================================
# Auth
# =========================================================
# Sinh khóa mới: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================================================
# TMDB
# =========================================================
TMDB_URL=https://api.themoviedb.org/3
TMDB_API_KEY=

# =========================================================
# AI Chatbot — Embedding
# =========================================================
# EMBEDDING_PROVIDER ∈ {"local", "openai"}.
#   local  -> sentence-transformers/all-MiniLM-L6-v2 (384 chiều)
#   openai -> text-embedding-3-small (1536 chiều)
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384

# =========================================================
# AI Chatbot — LLM
# =========================================================
# LLM_PROVIDER ∈ {"openai", "gemini", "groq"}.
# LLM_MODEL ví dụ: gpt-4o-mini | gemini-1.5-flash | llama-3.1-8b-instant
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=30

# =========================================================
# AI Chatbot — RAG
# =========================================================
RAG_TOP_K=8
RAG_TOKEN_BUDGET=6000
RAG_MIN_SIMILARITY=0.25
PERSONALIZATION_TOKEN_BUDGET=800

# =========================================================
# AI Chatbot — Cache TTL (seconds)
# =========================================================
CACHE_TTL_EMBEDDING_SECONDS=3600
CACHE_TTL_RETRIEVAL_SECONDS=600

# =========================================================
# AI Chatbot — Rate limit
# =========================================================
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_HOUR=200
